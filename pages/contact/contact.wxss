.contact {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx;
}

.c-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.c-hero-icon {
  font-size: 80rpx;
}

.c-hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-top: 16rpx;
}

.c-hero-sub {
  font-size: 24rpx;
  letter-spacing: 4rpx;
  color: var(--color-text-sub);
  margin-top: 8rpx;
}

.c-card {
  margin-top: 20rpx;
}

.c-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--color-border);
}

.c-row:last-child {
  border-bottom: none;
}

.c-label {
  color: var(--color-text-sub);
  font-size: 28rpx;
}

.c-value {
  color: var(--color-text);
  font-size: 28rpx;
}

.c-notice {
  margin-top: 32rpx;
  color: var(--color-text-sub);
  font-size: 24rpx;
  text-align: center;
  line-height: 1.6;
}

.c-service {
  margin-top: 48rpx;
}
