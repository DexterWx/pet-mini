.confirm {
  padding: 24rpx;
}

.c-line {
  display: flex;
  background: var(--color-card);
  border: var(--edge-width) solid var(--color-edge);
  border-radius: var(--radius);
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}

.c-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.c-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.c-title {
  font-size: 28rpx;
  color: var(--color-text);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.c-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.c-price {
  color: var(--color-primary);
  font-size: 32rpx;
  font-weight: 600;
}

.c-qty {
  color: var(--color-text-sub);
  font-size: 26rpx;
}

/* 金额明细：商品金额 + 运费 = 合计（.card 已提供背景与内边距） */
.c-amounts {
  margin-top: 24rpx;
}

.c-amt-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--color-text);
  font-size: 26rpx;
  line-height: 2;
}

.c-amt-free {
  color: var(--color-primary);
}

.c-amt-total {
  margin-top: 8rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--color-border);
  font-size: 28rpx;
}

.c-amt-tip {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-sub);
}

.c-total-num {
  color: var(--color-primary);
  font-size: 40rpx;
  font-weight: 700;
  margin-left: 16rpx;
}

.c-pay-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--color-text-sub);
}

.c-pay-tip.warn {
  color: var(--color-primary);
}

.c-delivery-opt.disabled {
  opacity: 0.4;
}

.c-submit {
  margin-top: 40rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.card {
  background: var(--color-card);
  border: var(--edge-width) solid var(--color-edge);
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}

.c-addr {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.c-addr-line1 {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.c-addr-line2 {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--color-text-sub);
}

.c-addr-empty {
  font-size: 28rpx;
  color: var(--color-primary);
}

.c-addr-edit {
  font-size: 26rpx;
  color: var(--color-text-sub);
  padding-left: 24rpx;
}

.c-delivery {
  display: flex;
  align-items: center;
}

.c-delivery-label {
  font-size: 28rpx;
  color: var(--color-text);
  margin-right: 24rpx;
}

.c-delivery-opts {
  display: flex;
  flex: 1;
}

.c-delivery-opt {
  padding: 8rpx 30rpx;
  margin-right: 20rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--color-text-sub);
  background: var(--color-cream);
  border: var(--edge-width) solid transparent;
}

.c-delivery-opt.active {
  color: #fff;
  background: var(--color-primary);
  border-color: var(--color-primary);
  font-weight: 600;
}
