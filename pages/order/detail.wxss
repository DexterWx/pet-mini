.odetail {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx;
}

.od-status {
  background: var(--gradient-brand);
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  border-radius: var(--radius-lg);
  padding: 40rpx 32rpx;
  box-shadow: var(--shadow-card);
}

.od-card {
  margin-top: 24rpx;
}

.od-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}

.od-label {
  color: var(--color-text-sub);
  font-size: 26rpx;
}

.od-value {
  color: var(--color-text);
  font-size: 26rpx;
}

.od-line {
  display: flex;
  padding: 16rpx 0;
}

.od-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.od-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.od-title {
  font-size: 28rpx;
  color: var(--color-text);
}

.od-row2 {
  display: flex;
  justify-content: space-between;
}

.od-price {
  color: var(--color-primary);
  font-size: 30rpx;
  font-weight: 600;
}

.od-qty {
  color: var(--color-text-sub);
  font-size: 26rpx;
}

/* 金额明细行（商品金额 / 运费） */
.od-amt-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 26rpx;
  color: var(--color-text);
  line-height: 2;
}

.od-free {
  color: var(--color-primary);
}

.od-total {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--color-border);
  font-size: 28rpx;
}

.od-total-num {
  color: var(--color-primary);
  font-size: 36rpx;
  font-weight: 700;
  margin-left: 16rpx;
}

.od-actions {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
}

.od-btn {
  border-radius: 999rpx;
  text-align: center;
  padding: 18rpx 0;
  font-size: 30rpx;
  background: var(--color-cream);
  border: var(--edge-width) solid var(--color-edge);
  margin-bottom: 20rpx;
}

.od-btn:last-child {
  margin-bottom: 0;
}

.od-btn-outline {
  color: var(--color-primary);
  border: var(--edge-width) solid var(--color-edge);
  font-weight: 600;
}

.od-btn-primary {
  color: #fff;
  background: var(--color-primary);
  border-color: var(--color-primary);
  font-weight: 600;
}

.od-refund-tip {
  font-size: 26rpx;
  color: var(--color-text-sub);
  text-align: center;
  margin-bottom: 20rpx;
}

/* 已完成说明（主动/自动确认收货） */
.od-done-tip {
  font-size: 26rpx;
  color: var(--color-primary);
  text-align: center;
  margin-bottom: 20rpx;
}

.od-btn-ghost {
  color: var(--color-text-sub);
  border: 2rpx solid var(--color-border);
}

.od-btn-hover {
  opacity: 0.7;
}
