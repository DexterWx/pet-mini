.olist {
  min-height: 100vh;
  background: var(--color-bg);
}

.tabs {
  display: flex;
  background: #fff;
  padding: 20rpx 0;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text);
  padding-bottom: 12rpx;
}

.tab.active {
  color: var(--color-primary);
  font-weight: 600;
  border-bottom: 4rpx solid var(--color-primary);
}

.orders {
  padding: 24rpx;
}

.order {
  background: var(--color-card);
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.o-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.o-no {
  color: var(--color-text-sub);
  font-size: 24rpx;
}

.o-status {
  color: var(--color-primary);
  font-size: 26rpx;
  font-weight: 600;
}

.o-items {
  display: flex;
  margin-top: 20rpx;
}

.o-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-sm);
  margin-right: 16rpx;
}

.o-foot {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.o-time {
  color: var(--color-text-sub);
  font-size: 22rpx;
  flex: 1;
}

.o-total {
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 20rpx;
}

.o-ship {
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
  border-radius: 999rpx;
  padding: 8rpx 24rpx;
  font-size: 24rpx;
}
