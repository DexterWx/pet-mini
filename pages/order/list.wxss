.olist {
  min-height: 100vh;
  background: var(--color-bg);
}

.tabs {
  display: flex;
  background: var(--color-card);
  border-bottom: var(--edge-width) solid var(--color-edge);
  padding: 20rpx 0;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: var(--shadow-card);
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text);
  padding-bottom: 12rpx;
}

.tab.active {
  color: var(--color-primary);
  font-weight: 600;
  border-bottom: 4rpx solid var(--color-primary);
}

.orders {
  padding: 24rpx;
}

.order {
  background: var(--color-card);
  border: var(--edge-width) solid var(--color-edge);
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.o-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.o-no {
  color: var(--color-text-sub);
  font-size: 24rpx;
}

.o-status {
  color: var(--color-primary);
  font-size: 26rpx;
  font-weight: 600;
}

.o-items {
  display: flex;
  margin-top: 20rpx;
}

.o-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-sm);
  margin-right: 16rpx;
}

.o-foot {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.o-time {
  color: var(--color-text-sub);
  font-size: 22rpx;
  flex: 1;
}

.o-total {
  color: var(--color-text);
  font-size: 28rpx;
  font-weight: 600;
  margin-right: 20rpx;
}

.o-pay {
  background: var(--color-primary);
  color: #fff;
  border: var(--edge-width) solid var(--color-primary);
  border-radius: 999rpx;
  padding: 6rpx 26rpx;
  font-size: 24rpx;
  font-weight: 600;
}

/* 确认收货：奶白底 + 黑边描边，与去支付区分 */
.o-confirm {
  background: var(--color-cream);
  color: var(--color-primary);
  border: var(--edge-width) solid var(--color-edge);
}
