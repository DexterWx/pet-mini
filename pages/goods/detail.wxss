.detail-wrap {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 120rpx;
}

.d-swiper-wrap {
  position: relative;
}

.d-swiper {
  height: 750rpx;
}

.d-img {
  width: 100%;
  height: 750rpx;
}

.d-count {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  background: rgba(0, 0, 0, 0.4);
  color: #fff;
  font-size: 24rpx;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
}

.d-info {
  background: var(--color-card);
  border: var(--edge-width) solid var(--color-edge);
  border-radius: var(--radius);
  padding: 24rpx;
  margin: 12rpx 24rpx 0;
  box-shadow: var(--shadow-card);
}

.d-price {
  color: var(--color-primary);
  font-size: 48rpx;
  font-weight: 700;
}

.d-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-top: 16rpx;
}

.d-desc {
  display: block;
  font-size: 26rpx;
  color: var(--color-text-sub);
  margin-top: 16rpx;
  line-height: 1.6;
}

.d-meta {
  display: flex;
  margin-top: 24rpx;
  color: var(--color-text-sub);
  font-size: 24rpx;
}

.d-meta text {
  margin-right: 32rpx;
}

/* 包邮/运费标识（规则来自 /shipping/config）
   .d-info 为普通 block，必须 inline-block 才能按内容宽度自适应，
   否则 view 会撑满整行变成通栏色块 */
.d-ship {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  width: fit-content;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-radius: var(--radius-xs);
  padding: 10rpx 16rpx;
}

.d-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  background: var(--color-card);
  border-top: var(--edge-width) solid var(--color-edge);
  padding: 12rpx 16rpx calc(12rpx + env(safe-area-inset-bottom));
  box-shadow: var(--shadow-bar);
}

.d-bar-icon {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 16rpx;
}

.d-bar-icon.on .d-bar-label {
  color: var(--color-primary);
}

/* 客服点击层：微信原生 button 的 UA 样式（固定 height、margin:auto、宽度行为等）
   无法完全重置，改用绝对定位透明覆盖层——它不参与底栏 flex 布局，
   因此图标列与普通 view 列宽度完全一致，不会撑宽把右侧按钮挤到溢出 */
.d-bar-hit {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  min-height: 0;
  margin: 0;
  padding: 0;
  opacity: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  line-height: normal;
  font-size: 0;
}

.d-bar-hit::after {
  border: none;
}

.d-bar-emoji {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 40rpx;
}

.d-bar-label {
  font-size: 20rpx;
  color: var(--color-text-sub);
  margin-top: 4rpx;
}

.d-bar-btn {
  flex: 1;
  min-width: 0;
  text-align: center;
  white-space: nowrap;
  color: #fff;
  font-size: 28rpx;
  padding: 20rpx 0;
  margin-left: 12rpx;
}

.d-bar-btn.add {
  background: var(--color-ink-soft);
  border-radius: 999rpx 0 0 999rpx;
}

.d-bar-btn.buy {
  background: var(--color-primary);
  border-radius: 0 999rpx 999rpx 0;
  margin-left: 0;
  font-weight: 600;
}

.d-bar-btn-hover {
  opacity: 0.85;
}
