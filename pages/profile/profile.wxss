.profile {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx;
}

.p-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-card);
  border: var(--edge-width) solid var(--color-edge);
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.p-label {
  font-size: 28rpx;
  color: var(--color-text);
}

.p-avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: normal;
}

.p-avatar-btn::after {
  border: none;
}

.p-input {
  flex: 1;
  margin-left: 24rpx;
  text-align: right;
  font-size: 28rpx;
  color: var(--color-text);
}

.p-value {
  flex: 1;
  margin-left: 24rpx;
  text-align: right;
  font-size: 28rpx;
  color: var(--color-text);
}

.p-rebind {
  margin-left: 24rpx;
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 52rpx;
  font-size: 24rpx;
  color: var(--color-primary);
  background: var(--color-cream);
  border: var(--edge-width) solid var(--color-edge);
  border-radius: 999rpx;
}

.p-rebind::after {
  border: none;
}

.p-hint {
  font-size: 22rpx;
  color: var(--color-text-sub);
  line-height: 1.6;
  padding: 0 12rpx;
  margin-bottom: 48rpx;
}

.p-save-disabled {
  opacity: 0.6;
}
