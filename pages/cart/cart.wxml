<view class="cart">
  <block wx:if="{{needLogin}}">
    <view class="needlogin">
      <text class="needlogin-tip">登录后查看购物车</text>
      <view class="btn-primary needlogin-btn" bindtap="goLogin" hover-class="btn-primary-hover">去登录</view>
    </view>
  </block>

  <block wx:else>
    <state-view status="{{cartStatus}}" empty-text="购物车空空如也~" bind:retry="loadCart">
      <view class="lines">
        <view class="line" wx:for="{{lines}}" wx:key="productId">
          <view class="line-check {{item.checked ? 'on' : ''}}" data-id="{{item.productId}}" bindtap="onToggleCheck">{{item.checked ? '✓' : ''}}</view>
          <goods-image src="{{item.product.images[0]}}" customClass="gi-thumb"></goods-image>
          <view class="line-info">
            <text class="line-title">{{item.product.title}}</text>
            <view class="line-bottom">
              <text class="line-price">¥{{item.priceText}}</text>
              <view class="stepper">
                <view class="step" data-id="{{item.productId}}" data-delta="-1" bindtap="onStep">-</view>
                <text class="step-num">{{item.qty}}</text>
                <view class="step" data-id="{{item.productId}}" data-delta="1" bindtap="onStep">+</view>
              </view>
            </view>
          </view>
          <view class="line-del" data-id="{{item.productId}}" bindtap="onDelete">删除</view>
        </view>
      </view>
    </state-view>

    <view class="cart-bar" wx:if="{{lines.length}}">
      <view class="bar-check {{allChecked ? 'on' : ''}}" bindtap="onToggleAll">{{allChecked ? '✓' : ''}} 全选</view>
      <text class="bar-total">合计 ¥{{totalText}}</text>
      <view class="bar-btn" bindtap="onCheckout" hover-class="bar-btn-hover">去结算({{checkedCount}})</view>
    </view>
  </block>

  <view class="rec-header">— 为您推荐 —</view>
  <state-view status="{{recStatus}}" empty-text="暂无推荐" bind:retry="loadRecommend">
    <view class="grid-2 rec-grid">
      <view class="grid-item" wx:for="{{recommend}}" wx:key="id">
        <goods-card goods="{{item}}" layout="grid" bind:cardtap="onCardTap" bind:cardadd="onCardAdd"></goods-card>
      </view>
    </view>
  </state-view>
</view>
