<view class="cart">
  <block wx:if="{{needLogin}}">
    <view class="needlogin">
      <text class="needlogin-tip">登录后查看购物车</text>
      <view class="btn-primary needlogin-btn" bindtap="goLogin" hover-class="btn-primary-hover">去登录</view>
    </view>
  </block>

  <block wx:else>
    <state-view status="{{cartStatus}}" empty-text="购物车空空如也~" bind:retry="loadCart">
      <view class="lines">
        <view class="line" wx:for="{{lines}}" wx:key="productId">
          <view class="line-check {{item.checked ? 'on' : ''}}" data-id="{{item.productId}}" bindtap="onToggleCheck"><icon wx:if="{{item.checked}}" name="check" size="26" color="#fff" /></view>
          <goods-image src="{{item.product.images[0]}}" customClass="gi-thumb" data-id="{{item.productId}}" bindtap="onLineDetail"></goods-image>
          <view class="line-info">
            <text class="line-title" data-id="{{item.productId}}" bindtap="onLineDetail">{{item.product.title}}</text>
            <view class="line-bottom">
              <text class="line-price">¥{{item.priceText}}</text>
              <view class="stepper">
                <view class="step" data-id="{{item.productId}}" data-delta="-1" bindtap="onStep">-</view>
                <text class="step-num">{{item.qty}}</text>
                <view class="step" data-id="{{item.productId}}" data-delta="1" bindtap="onStep">+</view>
              </view>
            </view>
          </view>
          <view class="line-del" data-id="{{item.productId}}" bindtap="onDelete">删除</view>
        </view>
      </view>
    </state-view>

    <view class="cart-bar" wx:if="{{lines.length}}">
      <view class="bar-check {{allChecked ? 'on' : ''}}" bindtap="onToggleAll"><icon wx:if="{{allChecked}}" name="check" size="24" color="#1F1D1B" /><text>全选</text></view>
      <view class="bar-total">
        <text>合计 ¥{{totalText}}</text>
        <view class="bar-ship" wx:if="{{shipTip}}"><icon name="truck" size="22" color="#8B857C" /><text>{{shipTip}}</text></view>
      </view>
      <view class="bar-btn" bindtap="onCheckout" hover-class="bar-btn-hover">去结算({{checkedCount}})</view>
    </view>
  </block>
</view>
