.cart {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 140rpx;
}

.needlogin {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 60rpx;
}

.needlogin-tip {
  color: var(--color-text-sub);
  font-size: 28rpx;
  margin-bottom: 40rpx;
}

.needlogin-btn {
  width: 400rpx;
}

.lines {
  padding: 20rpx 24rpx;
}

.line {
  display: flex;
  align-items: center;
  background: var(--color-card);
  border-radius: var(--radius);
  padding: 20rpx;
  margin-bottom: 20rpx;
  position: relative;
}

.line-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid var(--color-border);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.line-check.on {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.line-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.line-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 160rpx;
}

.line-title {
  font-size: 28rpx;
  color: var(--color-text);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.line-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.line-price {
  color: var(--color-primary);
  font-size: 32rpx;
  font-weight: 600;
}

.stepper {
  display: flex;
  align-items: center;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
}

.step {
  width: 52rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text);
  font-size: 30rpx;
}

.step-num {
  min-width: 60rpx;
  text-align: center;
  font-size: 26rpx;
}

.line-del {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  color: var(--color-text-sub);
  font-size: 24rpx;
}

.cart-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  background: var(--color-card);
  padding: 16rpx 24rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.bar-check {
  color: var(--color-text);
  font-size: 26rpx;
  margin-right: 20rpx;
}

.bar-check.on {
  color: var(--color-primary);
}

.bar-total {
  flex: 1;
  color: var(--color-primary);
  font-size: 30rpx;
  font-weight: 600;
}

.bar-btn {
  background: var(--color-primary);
  color: #fff;
  border-radius: 999rpx;
  padding: 16rpx 48rpx;
  font-size: 28rpx;
}

.bar-btn-hover {
  opacity: 0.85;
}

.rec-header {
  text-align: center;
  color: var(--color-text-sub);
  font-size: 26rpx;
  margin: 40rpx 0 24rpx;
}

.rec-grid {
  padding: 0 24rpx;
}
