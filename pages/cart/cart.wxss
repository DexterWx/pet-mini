.cart {
  min-height: 100vh;
  background: var(--color-bg);
  /* 结算条（140rpx）+ 自定义 tabBar（120rpx）+ 安全区 */
  padding-bottom: calc(280rpx + env(safe-area-inset-bottom));
}

.needlogin {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 60rpx;
}

.needlogin-tip {
  color: var(--color-text-sub);
  font-size: 28rpx;
  margin-bottom: 40rpx;
}

.needlogin-btn {
  width: 400rpx;
}

.lines {
  padding: 20rpx 24rpx;
}

.line {
  display: flex;
  align-items: center;
  background: var(--color-card);
  border: var(--edge-width) solid var(--color-edge);
  border-radius: var(--radius);
  padding: 20rpx;
  margin-bottom: 20rpx;
  position: relative;
  box-shadow: var(--shadow-card);
}

.line-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: var(--edge-width) solid var(--color-edge);
  background: transparent;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.line-check.on {
  background: var(--color-primary);
  border-color: var(--color-primary);
}

.line-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
}

.line-info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 160rpx;
}

.line-title {
  font-size: 28rpx;
  color: var(--color-text);
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.line-title:active {
  opacity: 0.6;
}

.line-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.line-price {
  color: var(--color-primary);
  font-size: 32rpx;
  font-weight: 600;
}

.stepper {
  display: flex;
  align-items: center;
  border: var(--edge-width) solid var(--color-edge);
  border-radius: var(--radius-sm);
}

.step {
  width: 52rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text);
  font-size: 30rpx;
}

.step-num {
  min-width: 60rpx;
  text-align: center;
  font-size: 26rpx;
}

.line-del {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  color: var(--color-text-sub);
  font-size: 24rpx;
}

.cart-bar {
  position: fixed;
  left: 0;
  right: 0;
  /* 需避开整个 tabBar 占位：120rpx 内容高度 + 底部安全区（只算 120rpx 会被手势条那一段盖住） */
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  z-index: 100;
  display: flex;
  align-items: center;
  background: var(--color-card);
  border-top: var(--edge-width) solid var(--color-edge);
  padding: 16rpx 24rpx;
  box-shadow: var(--shadow-bar);
}

.bar-check {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: var(--color-text);
  font-size: 26rpx;
  margin-right: 20rpx;
}

.bar-check.on {
  color: var(--color-primary);
}

.bar-total {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  color: var(--color-primary);
  font-size: 30rpx;
  font-weight: 600;
}

/* 包邮/运费小字提示 */
.bar-ship {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 4rpx;
  color: var(--color-text-sub);
  font-size: 20rpx;
  font-weight: 400;
}

.bar-btn {
  background: var(--color-primary);
  color: #fff;
  border: var(--edge-width) solid var(--color-primary);
  border-radius: 999rpx;
  padding: 14rpx 46rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.bar-btn-hover {
  background: var(--color-primary-deep);
  border-color: var(--color-primary-deep);
  opacity: 1;
}
