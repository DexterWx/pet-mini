.cat {
  /* 分类页为整屏 flex 布局，需扣掉自定义 tabBar 的高度，否则商品列表底部被盖 */
  height: calc(100vh - 120rpx - env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  background: var(--color-bg);
}

.cat-search {
  padding: 16rpx 24rpx;
  background: var(--color-card);
}

.cat-body {
  flex: 1;
  display: flex;
  overflow: hidden;
}

.cat-side {
  width: 200rpx;
  height: 100%;
  background: var(--color-card);
}

.cat-item {
  padding: 32rpx 20rpx;
  font-size: 28rpx;
  color: var(--color-text);
  text-align: center;
  border-left: 6rpx solid transparent;
}

.cat-item.active {
  color: var(--color-primary);
  font-weight: 600;
  border-left-color: var(--color-primary);
  background: var(--color-bg);
}

.cat-main {
  flex: 1;
  height: 100%;
  background: var(--color-bg);
}

.sort-bar {
  display: flex;
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--color-bg);
  padding: 20rpx 12rpx;
}

.sort-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text);
}

.sort-item.active {
  color: var(--color-primary);
  font-weight: 600;
}

.cat-list {
  padding: 0 12rpx;
  display: flex;
  flex-direction: column;
}

.cat-list goods-card {
  margin-bottom: 16rpx;
  display: block;
}

.load-more {
  text-align: center;
  color: var(--color-text-sub);
  font-size: 24rpx;
  padding: 24rpx 0;
}
