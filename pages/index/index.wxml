<view class="home">
  <view class="home-search">
    <search-bar readonly bind:tap="goSearch"></search-bar>
  </view>

  <state-view status="{{homeStatus}}" empty-text="暂无首页内容" bind:retry="loadHome">
    <view class="home-top">
      <swiper
        wx:if="{{banners.length}}"
        class="banner"
        indicator-dots
        autoplay
        circular
        interval="4000"
        indicator-color="rgba(255,255,255,0.5)"
        indicator-active-color="#FFFFFF"
      >
        <swiper-item wx:for="{{banners}}" wx:key="id">
          <goods-image src="{{item.image}}" customClass="gi-banner"></goods-image>
        </swiper-item>
      </swiper>

      <view class="squares">
        <view
          class="square"
          wx:for="{{entries.squares}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onSquare"
          hover-class="square-hover"
        >
          <view class="square-icon">{{item.key === 'buy' ? '🛍️' : '📋'}}</view>
          <text class="square-title">{{item.title}}</text>
          <text class="square-sub" wx:if="{{item.sub}}">{{item.sub}}</text>
        </view>
      </view>

      <view class="promos">
        <view
          class="promo {{item.key === 'contact' ? 'promo-contact' : 'promo-recharge'}}"
          wx:for="{{entries.promos}}"
          wx:key="key"
          data-key="{{item.key}}"
          bindtap="onPromo"
          hover-class="promo-hover"
        >
          <view class="promo-text">
            <text class="promo-title">{{item.title}}</text>
            <text class="promo-sub">{{item.sub}}</text>
          </view>
          <view class="promo-icon">{{item.key === 'contact' ? '☎️' : '👛'}}</view>
        </view>
      </view>
    </view>
  </state-view>

  <view class="rec-header">— 为您推荐 —</view>

  <state-view status="{{recStatus}}" empty-text="暂无推荐商品" bind:retry="loadRecommend">
    <view class="grid-2 rec-grid">
      <view class="grid-item" wx:for="{{recommend}}" wx:key="id">
        <goods-card goods="{{item}}" layout="grid" bind:cardtap="onCardTap" bind:cardadd="onCardAdd"></goods-card>
      </view>
    </view>
  </state-view>
</view>
