.home {
  min-height: 100vh;
  background: var(--color-home-bg);
  /* 预留自定义 tabBar 高度（120rpx）+ 安全区 + 原本留白 */
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.home-search {
  padding: 16rpx 24rpx;
}

.home-top {
  padding: 0 24rpx;
}

/* 正方形大图 Banner（.home-top 左右各 24rpx 内边距 -> 内容宽 702rpx，高与宽一致） */
.banner {
  height: 702rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
  border: var(--edge-width) solid var(--color-edge);
  box-shadow: var(--shadow-card);
}

.banner-img {
  width: 100%;
  height: 702rpx;
  border-radius: var(--radius-lg);
}

.squares {
  display: flex;
  justify-content: space-between;
  margin-top: 32rpx;
}

.square {
  width: 48.5%;
  background: var(--color-cream);
  border: var(--edge-width) solid var(--color-edge);
  border-radius: var(--radius-lg);
  padding: 40rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-card);
}

.square-hover {
  opacity: 0.9;
}

.square-icon {
  font-size: 72rpx;
}

.square-title {
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text);
}

.square-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-sub);
}

.promos {
  margin-top: 32rpx;
}

.promo {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: var(--edge-width) solid var(--color-edge);
  border-radius: var(--radius);
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.promo-hover {
  opacity: 0.9;
}

.promo-recharge {
  background: var(--color-cream);
}

.promo-text {
  display: flex;
  flex-direction: column;
}

.promo-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text);
}

.promo-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: var(--color-text-sub);
}

.promo-icon {
  font-size: 56rpx;
}
