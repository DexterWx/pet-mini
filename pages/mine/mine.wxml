<view class="mine">
  <block wx:if="{{needLogin}}">
    <view class="needlogin">
      <text class="needlogin-tip">登录后查看会员中心</text>
      <view class="btn-primary needlogin-btn" bindtap="goLogin" hover-class="btn-primary-hover">去登录</view>
    </view>
  </block>

  <block wx:else>
    <view class="header">
      <state-view status="{{profileStatus}}" empty-text="暂无用户信息" bind:retry="loadProfile">
        <view class="header-inner">
          <view class="user-row" bindtap="goProfile">
            <goods-image src="{{user.avatar}}" customClass="gi-avatar"></goods-image>
            <view class="user-meta">
              <text class="nickname">{{user.nickname}}</text>
              <text class="member">普通会员</text>
            </view>
            <text class="user-edit">编辑资料 ></text>
          </view>
          <view class="stats">
            <view class="stat">
              <text class="stat-num">{{balanceText}}</text>
              <text class="stat-label">余额</text>
            </view>
          </view>
        </view>
      </state-view>
    </view>

    <view class="card order-card">
      <view class="card-head">
        <text class="card-title">我的订单</text>
        <text class="card-link" bindtap="goOrders" data-status="">查看全部 ></text>
      </view>
      <view class="order-quick">
        <view class="quick" bindtap="goOrders" data-status="PENDING_PAY">
          <view class="quick-icon"><icon name="banknote" size="46" color="#1F1D1B" /></view>
          <text class="quick-label">未付款</text>
        </view>
        <view class="quick" bindtap="goOrders" data-status="PAID_UNSHIPPED">
          <view class="quick-icon"><icon name="package" size="46" color="#1F1D1B" /></view>
          <text class="quick-label">未发货</text>
        </view>
        <view class="quick" bindtap="goOrders" data-status="SHIPPED">
          <view class="quick-icon"><icon name="truck" size="46" color="#1F1D1B" /></view>
          <text class="quick-label">已发货</text>
        </view>
        <view class="quick" bindtap="goOrders" data-status="AFTER_SALE">
          <view class="quick-icon"><icon name="refund" size="46" color="#1F1D1B" /></view>
          <text class="quick-label">退款/售后</text>
        </view>
      </view>
    </view>

    <view class="card tool-card">
      <text class="card-title">常用工具</text>
      <view class="tools">
        <view class="tool" bindtap="goCart"><view class="tool-icon"><icon name="cart" size="42" color="#1F1D1B" /></view><text class="tool-label">购物车</text></view>
        <view class="tool" bindtap="goFavorites"><view class="tool-icon"><icon name="heart" size="42" color="#1F1D1B" /></view><text class="tool-label">我的收藏</text></view>
        <view class="tool" bindtap="goAddress"><view class="tool-icon"><icon name="pin" size="42" color="#1F1D1B" /></view><text class="tool-label">收货地址</text></view>
        <view class="tool" bindtap="goRecharge"><view class="tool-icon"><icon name="wallet" size="42" color="#1F1D1B" /></view><text class="tool-label">余额充值</text></view>
        <view class="tool">
          <view class="tool-icon"><icon name="headset" size="42" color="#1F1D1B" /></view>
          <text class="tool-label">在线客服</text>
          <!-- 透明原生按钮覆盖整格：不参与 flex 布局，保证与其他工具项同宽同基线 -->
          <button class="tool-hit" open-type="contact"></button>
        </view>
        <view class="tool" bindtap="onLogout"><view class="tool-icon"><icon name="logout" size="42" color="#1F1D1B" /></view><text class="tool-label">退出登录</text></view>
      </view>
    </view>

    <view class="card recent-card" wx:if="{{recent.length}}">
      <text class="card-title">最近浏览</text>
      <scroll-view class="recent-scroll" scroll-x>
        <view class="recent-item" wx:for="{{recent}}" wx:key="id" data-id="{{item.id}}" bindtap="onRecentTap">
          <goods-image src="{{item.images[0]}}" customClass="gi-thumb"></goods-image>
          <text class="recent-title">{{item.title}}</text>
        </view>
      </scroll-view>
    </view>
  </block>
</view>
