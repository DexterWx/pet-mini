.mine {
  min-height: 100vh;
  background: var(--color-bg);
  padding-bottom: 120rpx;
}

.needlogin {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 60rpx;
}

.needlogin-tip {
  color: var(--color-text-sub);
  font-size: 28rpx;
  margin-bottom: 40rpx;
}

.needlogin-btn {
  width: 400rpx;
}

.header {
  background: linear-gradient(135deg, #F4574D, #F0413E);
  padding: 40rpx 32rpx 80rpx;
}

.header .state-view {
  min-height: 0;
}

.header .sv-tip, .header .sv-btn {
  color: #fff;
}

.user-row {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
}

.user-meta {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.nickname {
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
}

.member {
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
  margin-top: 8rpx;
}

.stats {
  display: flex;
  margin-top: 48rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
}

.stat-label {
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
  margin-top: 8rpx;
}

.card {
  margin: 24rpx;
}

.order-card {
  margin-top: -40rpx;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.card-link {
  color: var(--color-text-sub);
  font-size: 26rpx;
}

.order-quick {
  display: flex;
  margin-top: 32rpx;
}

.quick {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-icon {
  font-size: 48rpx;
}

.quick-label {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-text);
}

.tools {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.tool {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.tool-icon {
  font-size: 44rpx;
}

.tool-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-text);
}

.recent-scroll {
  white-space: nowrap;
  margin-top: 24rpx;
}

.recent-item {
  display: inline-block;
  width: 160rpx;
  margin-right: 20rpx;
}

.recent-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
}

.recent-title {
  display: block;
  font-size: 22rpx;
  color: var(--color-text);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dev-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #2C2C2C;
  padding: 12rpx 32rpx;
}

.dev-label {
  color: #ddd;
  font-size: 24rpx;
}
