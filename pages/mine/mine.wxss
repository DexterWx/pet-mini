.mine {
  min-height: 100vh;
  background: var(--color-bg);
  /* 自定义 tabBar（120rpx）+ 安全区 + 原本留白 */
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.needlogin {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 60rpx;
}

.needlogin-tip {
  color: var(--color-text-sub);
  font-size: 28rpx;
  margin-bottom: 40rpx;
}

.needlogin-btn {
  width: 400rpx;
}

.header {
  background: var(--gradient-brand);
  padding: 40rpx 32rpx 80rpx;
}

.header .state-view {
  min-height: 0;
}

.header .sv-tip, .header .sv-btn {
  color: #fff;
}

.user-row {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
}

.user-meta {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.nickname {
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.member {
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
  margin-top: 8rpx;
}

.user-edit {
  margin-left: auto;
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
}

.stats {
  display: flex;
  margin-top: 48rpx;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
}

.stat-label {
  color: rgba(255, 255, 255, 0.8);
  font-size: 24rpx;
  margin-top: 8rpx;
}

.card {
  margin: 24rpx;
}

.order-card {
  margin-top: -40rpx;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.card-link {
  color: var(--color-text-sub);
  font-size: 26rpx;
}

.order-quick {
  display: flex;
  margin-top: 32rpx;
}

.quick {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.quick-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 48rpx;
}

.quick-label {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-text);
}

.tools {
  display: flex;
  flex-wrap: nowrap;
  margin-top: 24rpx;
}

/* 5 个工具等分一行，避免换行后第二行错位 */
.tool {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tool-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44rpx;
  /* 固定行高：避免原生 button 与 view 的默认行高差异导致图标上下不对齐 */
  line-height: 1.4;
}

.tool-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.4;
  color: var(--color-text);
}

/* 在线客服点击层：微信原生 button 的 UA 样式无法完全重置，
   改用绝对定位透明覆盖层——不参与 flex 布局，因此列宽与基线与其他工具项完全一致 */
.tool-hit {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  min-height: 0;
  margin: 0;
  padding: 0;
  opacity: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  line-height: normal;
  font-size: 0;
}

.tool-hit::after {
  border: none;
}

.recent-scroll {
  white-space: nowrap;
  margin-top: 24rpx;
}

.recent-item {
  display: inline-block;
  width: 160rpx;
  margin-right: 20rpx;
}

.recent-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
}

.recent-title {
  display: block;
  font-size: 22rpx;
  color: var(--color-text);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dev-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-text);
  padding: 12rpx 32rpx;
}

.dev-label {
  color: rgba(255, 255, 255, 0.85);
  font-size: 24rpx;
}
