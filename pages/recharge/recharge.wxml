<view class="recharge">
  <state-view status="{{status}}" empty-text="暂无充值信息" bind:retry="load">
    <view class="r-balance">
      <view class="r-balance-head">
        <text class="r-balance-label">我的余额</text>
        <text class="r-records" bindtap="onRecords">充值记录 ></text>
      </view>
      <text class="r-balance-num">¥{{balanceText}}</text>
    </view>

    <view class="card r-card">
      <text class="r-label">选择充值档位</text>
      <view class="r-tiers">
        <view
          class="r-tier {{selectedId === item.id ? 'active' : ''}}"
          wx:for="{{tiers}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onTier"
        >
          <text class="r-tier-label">{{item.label}}</text>
          <text class="r-tier-sub">{{item.sub}}</text>
        </view>
      </view>
      <view class="r-empty-tip" wx:if="{{!tiers.length}}">管理员尚未配置充值档位，敬请期待</view>
      <view class="r-summary" wx:if="{{selectedId}}">
        <text>实充 ¥{{amountText}}</text>
        <text class="r-gift" wx:if="{{giftText !== '0'}}">赠 ¥{{giftText}}</text>
        <text class="r-total">到账合计 ¥{{totalText}}</text>
      </view>
    </view>

    <view class="btn-primary r-pay" bindtap="onPay" hover-class="btn-primary-hover">{{payText}}</view>
  </state-view>
</view>
