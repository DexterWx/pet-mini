.recharge {
  min-height: 100vh;
  background: var(--color-bg);
  padding: 24rpx;
}

.r-balance {
  background: var(--gradient-brand);
  border-radius: var(--radius-lg);
  padding: 48rpx 40rpx;
  box-shadow: var(--shadow-card);
}

.r-balance-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.r-balance-label {
  color: rgba(255, 255, 255, 0.9);
  font-size: 28rpx;
}

.r-records {
  color: #fff;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
}

.r-balance-num {
  display: block;
  color: #fff;
  font-size: 64rpx;
  font-weight: 700;
  margin-top: 32rpx;
}

.r-card {
  margin-top: 32rpx;
}

.r-label {
  color: var(--color-text-sub);
  font-size: 26rpx;
}

.r-tiers {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.r-tier {
  width: calc(50% - 10rpx);
  box-sizing: border-box;
  background: var(--color-cream);
  border: var(--edge-width) solid var(--color-edge);
  border-radius: var(--radius);
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 20rpx 20rpx 0;
}

.r-tier:nth-child(2n) {
  margin-right: 0;
}

.r-tier.active {
  border-color: var(--color-primary);
  background: var(--color-primary);
}

.r-tier.active .r-tier-label {
  color: #fff;
  font-weight: 700;
}

.r-tier.active .r-tier-sub {
  color: rgba(255, 255, 255, 0.75);
}

.r-tier-label {
  font-size: 30rpx;
  color: var(--color-text);
}

.r-tier-sub {
  font-size: 24rpx;
  color: var(--color-text-sub);
  margin-top: 8rpx;
}

.r-summary {
  margin-top: 12rpx;
  padding-top: 24rpx;
  border-top: 2rpx dashed var(--color-border);
  display: flex;
  align-items: baseline;
  font-size: 26rpx;
  color: var(--color-text);
}

.r-gift {
  margin-left: 24rpx;
  color: var(--color-primary);
  font-size: 26rpx;
}

.r-total {
  margin-left: auto;
  color: var(--color-primary);
  font-weight: 700;
  font-size: 30rpx;
}

.r-empty-tip {
  margin-top: 24rpx;
  text-align: center;
  color: var(--color-text-sub);
  font-size: 26rpx;
}

.r-pay {
  margin-top: 48rpx;
}
