<view class="login">
  <block wx:if="{{step === 'login'}}">
    <view class="login-hero">
      <text class="login-title">欢迎使用商城系统</text>
      <text class="login-sub">微信一键登录，安全便捷</text>
    </view>

    <view class="login-form">
      <view
        class="btn-primary login-btn {{logging ? 'login-btn-disabled' : ''}}"
        bindtap="onWechatLogin"
        hover-class="btn-primary-hover"
      >{{logging ? '登录中…' : '微信一键登录'}}</view>

      <view class="login-tip">登录即表示同意《用户协议》与《隐私政策》</view>
      <view class="login-skip" bindtap="onSkip">暂不登录</view>
    </view>
  </block>

  <!-- 首次登录：仅这一次请求头像昵称授权，之后登录与展示直接使用缓存 -->
  <block wx:else>
    <view class="login-hero login-hero-tight">
      <text class="login-title">设置头像和昵称</text>
      <text class="login-sub">只需设置这一次，之后自动使用，不再重复询问</text>
    </view>

    <view class="login-form">
      <view class="lp-row">
        <text class="lp-label">头像</text>
        <button class="lp-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <goods-image src="{{avatar}}" customClass="gi-avatar"></goods-image>
        </button>
      </view>

      <view class="lp-row">
        <text class="lp-label">昵称</text>
        <input
          class="lp-input"
          type="nickname"
          placeholder="点击填写或使用微信昵称"
          value="{{nickname}}"
          bindinput="onNickname"
          bindblur="onNickname"
          bindchange="onNickname"
        />
      </view>

      <view class="lp-hint">微信已不支持静默获取用户资料，需你主动点击一次授权填写；也可暂不设置，之后在「我的 - 编辑资料」中修改。</view>

      <view
        class="btn-primary lp-submit {{saving ? 'lp-disabled' : ''}}"
        bindtap="onProfileSubmit"
        hover-class="btn-primary-hover"
      >{{saving ? '保存中…' : '使用微信头像和昵称'}}</view>
      <view class="login-skip" bindtap="onProfileSkip">暂不设置</view>
    </view>
  </block>
</view>
