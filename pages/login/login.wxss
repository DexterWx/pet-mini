.login {
  min-height: 100vh;
  background: var(--color-bg);
}

.login-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 40rpx 80rpx;
}

.login-hero-tight {
  padding-top: 100rpx;
  padding-bottom: 48rpx;
}

.login-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-text);
}

.login-sub {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--color-text-sub);
}

.login-form {
  padding: 0 60rpx;
}

.login-btn {
  margin-top: 40rpx;
}

.login-btn-disabled {
  opacity: 0.6;
}

.login-tip {
  text-align: center;
  color: var(--color-text-sub);
  font-size: 22rpx;
  margin-top: 32rpx;
}

.login-skip {
  text-align: center;
  color: var(--color-text-sub);
  font-size: 26rpx;
  margin-top: 40rpx;
}

/* 首次登录的头像昵称采集行（组件内部尺寸由 goods-image 的 gi-avatar 控制） */
.lp-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-card);
  border: var(--edge-width) solid var(--color-edge);
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-card);
}

.lp-label {
  font-size: 28rpx;
  color: var(--color-text);
}

.lp-avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: normal;
}

.lp-avatar-btn::after {
  border: none;
}

.lp-input {
  flex: 1;
  margin-left: 24rpx;
  text-align: right;
  font-size: 28rpx;
  color: var(--color-text);
}

.lp-hint {
  font-size: 22rpx;
  color: var(--color-text-sub);
  line-height: 1.6;
  padding: 0 12rpx;
  margin-bottom: 40rpx;
}

.lp-submit {
  margin-top: 0;
}

.lp-disabled {
  opacity: 0.6;
}
