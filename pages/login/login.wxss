.login {
  min-height: 100vh;
  background: var(--color-bg);
}

.login-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx 60rpx;
}

.login-title {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-text);
}

.login-sub {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--color-text-sub);
}

.login-form {
  padding: 0 60rpx;
}

.field {
  display: flex;
  align-items: center;
  background: var(--color-card);
  border-radius: var(--radius);
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.field-label {
  width: 120rpx;
  color: var(--color-text);
  font-size: 28rpx;
}

.field-input {
  flex: 1;
  font-size: 28rpx;
}

.login-btn {
  margin-top: 40rpx;
}

.login-toggle {
  text-align: center;
  color: var(--color-primary);
  font-size: 26rpx;
  margin-top: 32rpx;
}

.login-skip {
  text-align: center;
  color: var(--color-text-sub);
  font-size: 26rpx;
  margin-top: 40rpx;
}
