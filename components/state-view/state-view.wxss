@import "/assets/styles/placeholder.wxss";

.state-view {
  min-height: 200rpx;
}

.sv-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 40rpx;
}

.sv-spinner {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  border: 6rpx solid var(--color-border, #eee);
  border-top-color: var(--color-primary, #F0413E);
  animation: sv-spin 0.8s linear infinite;
}

@keyframes sv-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.sv-icon {
  width: 120rpx;
  height: 120rpx;
  font-size: 48rpx;
  margin-bottom: 24rpx;
}

.sv-tip {
  color: var(--color-text-sub, #999);
  font-size: 26rpx;
  margin-top: 16rpx;
}

.sv-btn {
  margin-top: 32rpx;
  padding: 12rpx 56rpx;
  border-radius: 999rpx;
  background: var(--color-primary, #F0413E);
  color: #fff;
  font-size: 26rpx;
}

.sv-btn-hover {
  opacity: 0.85;
}
