/* assets/styles/placeholder.wxss
   纯色 / CSS 占位资源：正式 UI 资源到位后直接替换本文件或对应节点。
   熊猫配色：奶白底 + 暖灰图形，不使用彩色。 */
.ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F3EFE6;
  color: #B9B2A6;
}

/* 图片占位：奶白渐变 + 爪印 */
.ph-img {
  background: linear-gradient(135deg, #FBF9F4, #EDE7DB);
}

.ph-emoji {
  font-size: 56rpx;
}

/* 圆形图标占位 */
.ph-circle {
  border-radius: 50%;
  background: #FFFDF8;
  border: 2rpx solid #1F1D1B;
  color: #A9A296;
}
